{
  "manifest_version": 3,
  "name": "Coursera AutoPilot Pro",
  "version": "1.3.0",
  "description": "Intelligent Automation & Accelerated Learning Suite for Coursera",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.coursera.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.coursera.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icon.png"],
      "matches": ["*://*.coursera.org/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "antigravity-extension@ibi.dev",
      "strict_min_version": "109.0"
    }
  }
}
