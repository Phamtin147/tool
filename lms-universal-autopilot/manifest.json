{
  "manifest_version": 3,
  "name": "LMS Universal AutoPilot Pro",
  "version": "1.0.0",
  "description": "AI-powered automated quiz solver and stealth revision assistant for Canvas, Moodle, Blackboard, Google Forms & University LMS.",
  "author": "Amtia / Phamtin147",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
